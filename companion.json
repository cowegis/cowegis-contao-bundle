{
  "receipts": [
    "projects/contao-bundle/5.3"
  ],
  "config": {
    "phpConstraint": "^8.3",
    "directories": [
      "spec",
      "tests"
    ]
  },
  "tools": {
    "composer": {
      "namespace": "Cowegis\\Bundle\\Contao"
    },
    "phpcq": {
      "plugins": {
        "phpunit": true,
        "phpspec": true
      },
      "defaults": {
        "repositories": [
          "vendor/netzmacht/phpspec-phpcq-plugin/repository.json"
        ]
      },
      "presets": {
        "composer-require-checker": {
          "tasks": {
            "composer-require-checker": {
              "config":{
                "config_file": ".composer-require-checker.json"
              }
            }
          }
        },
        "phpcpd": {
          "tasks": {
            "phpcpd": {
              "config": {
                "exclude": [
                  "src/Resources/contao/dca/tl_cowegis_popup.php",
                  "src/Resources/contao/dca/tl_cowegis_style.php",
                  "src/Resources/contao/dca/tl_cowegis_icon.php",
                  "src/Resources/contao/dca/tl_cowegis_control.php"
                ]
              }
            }
          }
        }
      }
    },
    "psalm": {
      "configuration": {
        "errorLevel": "3"
      }
    }
  }
}
